{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshio.com.br/contracts/events/data/billing.trial_ending.schema.json",
  "title": "data for billing.trial_ending",
  "description": "The integrator's free trial ends soon (sent once, 3 days before the end). There is no automatic charge: to keep sending after the trial, subscribe. Envelope business_id and channel_id are null.",
  "type": "object",
  "required": [
    "ends_at",
    "days_left",
    "message_limit",
    "used_messages"
  ],
  "properties": {
    "cycle_id": {
      "type": "string",
      "pattern": "^cyc_[A-Za-z0-9]+$",
      "description": "Billing cycle id."
    },
    "ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "End of the trial."
    },
    "days_left": {
      "type": "integer",
      "minimum": 0
    },
    "message_limit": {
      "type": "integer",
      "minimum": 0,
      "description": "Messages included in the trial."
    },
    "used_messages": {
      "type": "integer",
      "minimum": 0,
      "description": "Messages counted in the trial so far."
    }
  },
  "additionalProperties": true
}
