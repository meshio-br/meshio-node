{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshio.com.br/contracts/events/data/message.status_changed.schema.json",
  "title": "data for message.status_changed",
  "description": "Forward-only status change of an outbound message. Ranks: queued 0, sending 1, unknown 1, accepted_by_meta 2, delivered 3, read 4; failed is terminal and may follow any rank <= 3. Events may arrive out of order: never regress.",
  "type": "object",
  "required": [
    "message_id",
    "direction",
    "origin",
    "status",
    "previous_status",
    "to"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "pattern": "^msg_[A-Za-z0-9]+$"
    },
    "direction": {
      "const": "outbound"
    },
    "origin": {
      "type": "string",
      "enum": [
        "api",
        "panel",
        "business_app",
        "unknown"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "template",
        "unsupported"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "sending",
        "accepted_by_meta",
        "delivered",
        "read",
        "failed",
        "canceled",
        "unknown"
      ]
    },
    "previous_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "queued",
        "sending",
        "accepted_by_meta",
        "delivered",
        "read",
        "failed",
        "canceled",
        "unknown",
        null
      ]
    },
    "to": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{6,14}$"
    },
    "client_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "meta_message_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "meta_occurred_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Time reported by Meta for this status, when available."
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "Safe Meshio error code (UPPER_SNAKE_CASE). Values in examples are illustrative; original Meta codes stay in restricted diagnostics."
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object"
          }
        }
      }
    }
  ]
}
