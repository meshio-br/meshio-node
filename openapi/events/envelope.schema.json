{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshio.com.br/contracts/events/envelope.schema.json",
  "title": "Meshio outbound webhook event envelope (v1)",
  "description": "Body of every POST delivered to an integrator webhook endpoint. Signed with Meshio-Signature: v1=hex(HMAC_SHA256(secret, \"{Meshio-Timestamp}.{raw_body}\")). Delivery is at-least-once: deduplicate by event_id. Unknown fields must be ignored.",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "business_id", "channel_id", "data"],
  "properties": {
    "event_id": { "type": "string", "pattern": "^evt_[A-Za-z0-9]+$", "description": "Stable event id; equals the Meshio-Event-Id header." },
    "event_type": {
      "type": "string",
      "description": "Known values are listed; new types may be added (ignore unknown ones).",
      "examples": [
        "channel.connected",
        "channel.attention_required",
        "channel.disconnected",
        "message.received",
        "message.status_changed",
        "template.status_changed",
        "webhook.test",
        "billing.trial_ending",
        "billing.trial_ended",
        "channel.health_changed",
        "contact.opted_out",
        "contact.opted_in",
        "message.policy_blocked",
        "business.compliance_hold",
        "channel.compliance_hold",
        "billing.allowance_warning",
        "billing.allowance_exhausted",
        "billing.overage_limit_reached",
        "billing.invoice_created",
        "billing.invoice_paid",
        "billing.invoice_past_due",
        "billing.subscription_updated"
      ]
    },
    "occurred_at": { "type": "string", "format": "date-time", "description": "UTC ISO 8601 time of the underlying fact." },
    "business_id": { "type": ["string", "null"], "pattern": "^biz_[A-Za-z0-9]+$" },
    "channel_id": { "type": ["string", "null"], "pattern": "^chn_[A-Za-z0-9]+$" },
    "data": { "type": "object" }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "channel.connected" } } },
      "then": { "properties": { "data": { "$ref": "data/channel.connected.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "channel.attention_required" } } },
      "then": { "properties": { "data": { "$ref": "data/channel.attention_required.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "channel.disconnected" } } },
      "then": { "properties": { "data": { "$ref": "data/channel.disconnected.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "message.received" } } },
      "then": { "properties": { "data": { "$ref": "data/message.received.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "message.status_changed" } } },
      "then": { "properties": { "data": { "$ref": "data/message.status_changed.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "template.status_changed" } } },
      "then": { "properties": { "data": { "$ref": "data/template.status_changed.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "webhook.test" } } },
      "then": { "properties": { "data": { "$ref": "data/webhook.test.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "billing.trial_ending" } } },
      "then": { "properties": { "data": { "$ref": "data/billing.trial_ending.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "billing.trial_ended" } } },
      "then": { "properties": { "data": { "$ref": "data/billing.trial_ended.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "channel.health_changed" } } },
      "then": { "properties": { "data": { "$ref": "data/channel.health_changed.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "contact.opted_out" } } },
      "then": { "properties": { "data": { "$ref": "data/contact.opted_out.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "contact.opted_in" } } },
      "then": { "properties": { "data": { "$ref": "data/contact.opted_in.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "message.policy_blocked" } } },
      "then": { "properties": { "data": { "$ref": "data/message.policy_blocked.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "business.compliance_hold" } } },
      "then": { "properties": { "data": { "$ref": "data/business.compliance_hold.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "channel.compliance_hold" } } },
      "then": { "properties": { "data": { "$ref": "data/channel.compliance_hold.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "billing.allowance_warning" } } },
      "then": { "properties": { "data": { "$ref": "data/billing.allowance.common.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "billing.allowance_exhausted" } } },
      "then": { "properties": { "data": { "$ref": "data/billing.allowance.common.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "billing.overage_limit_reached" } } },
      "then": { "properties": { "data": { "$ref": "data/billing.overage_limit_reached.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "billing.invoice_created" } } },
      "then": { "properties": { "data": { "$ref": "data/billing.invoice_created.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "billing.invoice_paid" } } },
      "then": { "properties": { "data": { "$ref": "data/billing.invoice_paid.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "billing.invoice_past_due" } } },
      "then": { "properties": { "data": { "$ref": "data/billing.invoice_past_due.schema.json" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "billing.subscription_updated" } } },
      "then": { "properties": { "data": { "$ref": "data/billing.subscription_updated.schema.json" } } }
    }
  ]
}
